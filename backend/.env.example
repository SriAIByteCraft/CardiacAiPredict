# Flask Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=dev_insecure_secret_key_heart_prediction_9921
SESSION_COOKIE_SECURE=False
FRONTEND_ORIGIN=*

# MongoDB Connection
# Set your MongoDB Atlas connection string here. If not provided or unreachable,
# the app gracefully falls back to an in-memory/mock store for offline demonstration and testing.
MONGODB_URI=
MONGODB_DB_NAME=heart_disease_db

# Machine Learning Artifacts
MODEL_ARTIFACT_PATH=ml/artifacts/stacking_heart_model.joblib
METRICS_ARTIFACT_PATH=ml/artifacts/model_metrics.json
COMPARISON_ARTIFACT_PATH=ml/artifacts/model_comparison.json
