# Environment Configuration Template
FLASK_ENV=development
PORT=5000
SECRET_KEY=replace_this_with_a_secure_random_hex_key_in_production
SESSION_COOKIE_SECURE=False
FRONTEND_ORIGIN=http://127.0.0.1:5500

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=heart_disease_db

# Model Artifacts Path
MODEL_ARTIFACT_PATH=ml/artifacts/stacking_heart_model.joblib
METRICS_ARTIFACT_PATH=ml/artifacts/model_metrics.json
COMPARISON_ARTIFACT_PATH=ml/artifacts/model_comparison.json
